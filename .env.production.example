# =============================================================================
#  PIN247 — TEMPLATE ENVIRONMENT cho PRODUCTION (InfinityFree / shared hosting)
#
#  CÁCH DÙNG:
#   1. Copy file này thành `.env` trên hosting (KHÔNG commit lên Git).
#   2. Điền giá trị thật cho các mục đánh dấu [BẮT BUỘC].
#   3. Upload `.env` SAU `.htaccess` để không bao giờ có cửa sổ truy cập
#      công khai (xem DEPLOY_GUIDE.md §6.2).
#
#  File này KHÔNG chứa secret thật. `.env` và `.env.production` đã nằm trong
#  .gitignore.
# =============================================================================

APP_NAME="PIN247"

# --- [BẮT BUỘC] production ---
APP_ENV=production
APP_DEBUG=false

# [BẮT BUỘC] APP_KEY phải KHỚP với APP_KEY dùng để tạo SQL dump.
# Vì `bigseller_connections.app_key/access_token/refresh_token` được mã hoá
# bằng encrypted cast của Laravel (AES-256-CBC với APP_KEY).
# Nếu lệch => DecryptException khi đọc connection BigSeller.
# Lấy key từ file `.env` cục bộ (không commit lên Git).
APP_KEY=base64:CHANG_DOI_BANG_APP_KEY_TU_LOCAL

# [BẮT BUỘC] Domain đã trỏ DNS + SSL đã bật.
APP_URL=https://example.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

# file: dùng maintenance mode bằng file trong storage/framework
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# error: không rò rỉ chi tiết lỗi ra log production
LOG_LEVEL=error

# -----------------------------------------------------------------------------
#  DATABASE (InfinityFree)
#
#  [BẮT BUỘC] DB_HOST KHÔNG phải "localhost" — thường có dạng:
#      sql123.infinityfree.com
#  Lấy đúng giá trị trong Control Panel → MySQL Databases → MySQL Credentials.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=sql123.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_12345678_pin247
DB_USERNAME=if0_12345678
DB_PASSWORD=matkhau
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# -----------------------------------------------------------------------------
#  SESSION / CACHE / QUEUE
#
#  - SESSION_DRIVER=database: dùng bảng `sessions` (đã có trong SQL dump).
#  - CACHE_STORE=file: ghi vào storage/framework/cache (cần chmod 777).
#    Tránh `database` vì cache table bị ghi/xoá liên tục.
#  - QUEUE_CONNECTION=sync: InfinityFree KHÔNG có queue worker.
#    Job sẽ chạy inline ngay trong request. Với BigSeller MOCK, job trả về
#    tức thì nên không treo.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Filesystem disk cho ảnh sản phẩm + file bảng giá.
# -> storage/app/public (không dùng public/storage vì InfinityFree cấm symlink).
FILESYSTEM_DISK=public

QUEUE_CONNECTION=sync

CACHE_STORE=file

# Redis không dùng trên shared hosting — giữ để không lỗi config.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: InfinityFree không cho gửi mail ra ngoài => dùng log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@pin247.vn"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
#  BIGSELLER — DEMO / MOCK MODE
#
#  mode: mock | live
#  `mock` -> MockBigSellerClient (in-memory, KHÔNG gọi API thật).
#  `live` -> HttpBigSellerClient (gọi API thật, cần base_url + token).
#
#  ⚠️ Bản demo này dùng MOCK. Không đổi sang `live` nếu chưa có tài khoản
#     BigSeller được cấp quyền Open API.
#
#  Việc đổi `mock` -> `live` KHÔNG cần sửa code, chỉ đổi env + điền
#  endpoint/token + cấu hình trong Admin → Đồng bộ BigSeller.
# -----------------------------------------------------------------------------
BIGSELLER_MODE=mock

# Base URL của BigSeller Open API. Bắt buộc lấy từ tài liệu API chính thức
# do BigSeller cung cấp sau khi tài khoản được duyệt quyền truy cập.
# Để trống => chế độ live sẽ báo lỗi "chưa cấu hình", KHÔNG tự bịa endpoint.
BIGSELLER_BASE_URL=
BIGSELLER_APP_ID=
BIGSELLER_APP_KEY=
BIGSELLER_ACCESS_TOKEN=
BIGSELLER_REFRESH_TOKEN=
BIGSELLER_TOKEN_EXPIRES_AT=

# Đường dẫn endpoint. Chỉ điền khi tài liệu chính thức xác nhận.
BIGSELLER_PATH_INVENTORY=
BIGSELLER_PATH_CREATE_ORDER=
BIGSELLER_PATH_CANCEL_ORDER=
BIGSELLER_PATH_ORDER_STATUS=
BIGSELLER_PATH_PRODUCTS=
BIGSELLER_PATH_WAREHOUSES=

# Timeout (giây) và số lần thử lại cho HTTP client
BIGSELLER_TIMEOUT=20
BIGSELLER_CONNECT_TIMEOUT=10

# Danh sách API được phép gọi. Chỉ bật sau khi được cấp quyền.
# inventory | create_order | cancel_order | order_status | products | warehouses
BIGSELLER_CAPABILITIES=inventory,create_order

# Chu kỳ đồng bộ tồn kho (phút) — chỉ dùng cho cron, InfinityFree không có cron
# nên phải bấm nút "Đồng bộ" trong Admin.
BIGSELLER_INVENTORY_SYNC_EVERY=15

# Số lượng tồn kho an toàn giữ lại cho website (để tránh bán vượt)
BIGSELLER_SAFETY_STOCK=0

VITE_APP_NAME="${APP_NAME}"
