APP_NAME="PIN247"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pin247_shop
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@pin247.vn"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# BIGSELLER CENTRAL INVENTORY
# ---------------------------------------------------------------------------
# mode: mock | live  (mock = MockBigSellerClient, KHÔNG dùng cho production)
BIGSELLER_MODE=mock

# Base URL của BigSeller Open API. Bắt buộc lấy từ tài liệu API chính thức
# do BigSeller cung cấp sau khi tài khoản được duyệt quyền truy cập.
# Để trống => chế độ live sẽ báo lỗi "chưa cấu hình", KHÔNG tự bịa endpoint.
BIGSELLER_BASE_URL=
BIGSELLER_APP_ID=
BIGSELLER_APP_KEY=
BIGSELLER_ACCESS_TOKEN=
BIGSELLER_REFRESH_TOKEN=
BIGSELLER_TOKEN_EXPIRES_AT=

# Đường dẫn endpoint. Chỉ điền khi tài liệu chính thức xác nhận.
BIGSELLER_PATH_INVENTORY=
BIGSELLER_PATH_CREATE_ORDER=
BIGSELLER_PATH_CANCEL_ORDER=
BIGSELLER_PATH_ORDER_STATUS=
BIGSELLER_PATH_PRODUCTS=
BIGSELLER_PATH_WAREHOUSES=

# Timeout (giây) và số lần thử lại cho HTTP client
BIGSELLER_TIMEOUT=20
BIGSELLER_CONNECT_TIMEOUT=10

# Danh sách API được phép gọi. Chỉ bật sau khi được cấp quyền.
# inventory | create_order | cancel_order | order_status | products | warehouses
BIGSELLER_CAPABILITIES=inventory,create_order

# Chu kỳ đồng bộ tồn kho (phút)
BIGSELLER_INVENTORY_SYNC_EVERY=15

# Số lượng tồn kho an toàn giữ lại cho website (để tránh bán vượt)
BIGSELLER_SAFETY_STOCK=0

VITE_APP_NAME="${APP_NAME}"
